+bool moveFileToTrash(const QString& filePath)
+{
+    // Qt 5.15+ provides QFile::moveToTrash(); on Qt 5.12 delegate to the freedesktop
+    // implementation shipped with GLib (gio trash), which honours XDG trash dirs.
+    QProcess process;
+    process.start("gio", QStringList() << "trash" << filePath);
+    if (!process.waitForStarted(3000)) {
+        return false;
+    }
+    if (!process.waitForFinished(10000)) {
+        process.kill();
+        process.waitForFinished(1000);
+        return false;
+    }
+    return process.exitStatus() == QProcess::NormalExit && process.exitCode() == 0;
+}
