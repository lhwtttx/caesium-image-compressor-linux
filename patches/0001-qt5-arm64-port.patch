     style->drawControl(QStyle::CE_ItemViewItem, &optionV, painter, optionV.widget);
 
+    const QRect textRect = style->subElementRect(QStyle::SE_ItemViewItemText, &optionV);
+    const int textHeight = static_cast<int>(qCeil(doc.size().height()));
+    const int offsetY = qMax(0, (textRect.height() - textHeight) / 2);
+
     QAbstractTextDocumentLayout::PaintContext ctx;
-    QRect textRect = style->subElementRect(QStyle::SE_ItemViewItemText, &optionV);
 
     painter->save();
